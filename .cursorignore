# =============================================================================
# .cursorignore — Darb monorepo (React/Vite + Spring Boot)
#
# Excludes dependencies, build artifacts, secrets, and machine-generated bulk
# from Cursor AI indexing. Source code, config, docs, and navigation aids stay
# accessible. Aligns with .gitignore plus Cursor-specific exclusions.
# =============================================================================

# --- Dependencies (vendor code; never edited) ---
node_modules
.venv/

# --- Build outputs ---
**/target/
**/dist/
frontend/dist-ssr/
build/
out/
*.class

# --- Archives & packaged artifacts ---
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Secrets (templates like .env.example remain indexed) ---
.env
.env.local
.env.*.local
frontend/.env.local
!.env.example
!frontend/.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS & editor noise ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Git internals (not useful for code assistance) ---
.git/

# --- JVM crash dumps ---
hs_err_pid*
replay_pid*

# --- Maven / IDE tooling metadata ---
HELP.md
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
.gradle/

# --- Legacy / scratch ---
*.ctxt
.mtj.tmp/

# --- Graphify: machine output only (keep navigation docs for architecture Q&A) ---
graphify-out/cache
graphify-out/graph.html

