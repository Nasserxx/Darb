# =============================================================================
# Cursor ignore — excludes libraries, binaries, build output, and caches
# from AI indexing. Syntax matches .gitignore.
# =============================================================================

# --- Version control ---
.git/

# --- Java / Maven / Spring Boot ---
target/
out/
.m2/
.m2repo/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml

# --- Node / frontend ---
dist
build
.vite
.nuxt
.next
.output
.parcel-cache
.turbo
.cache
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# --- Lock files (large, rarely needed for context) ---
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# --- Compiled / minified / generated web assets ---
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.map
*.bundle.css

# --- Binaries and archives ---
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.bin
*.dat
*.db
*.sqlite
*.sqlite3
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.bz2
*.xz
*.iso
*.dmg
*.msi
*.deb
*.rpm
*.apk
*.ipa

# --- Media (binary; exclude from indexing) ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.bmp
*.tiff
*.svg
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.webm
*.woff
*.woff2
*.ttf
*.eot
*.otf

# --- Documents / office (usually not source) ---
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# --- Logs, temp, and crash dumps ---
*.log
*.tmp
*.temp
*.pid
*.out
*.swp
*.swo
*~
*.bak
*.orig

# --- IDE and editor ---
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Test / coverage / reports ---
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/allure-results/
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/.pytest_cache/
**/__pycache__/
**/*.pyc

# --- Docker / local runtime data ---
**/.docker/

# --- Secrets and keys (sensitive, not useful for AI context) ---
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.keystore
**/*.jks
.env
.env.*
!.env.example

# --- Graphify / analysis artifacts ---
graphify-out/cache
graphify-out/graph.html
# --- Agent / tool caches ---
.claude
node_modules