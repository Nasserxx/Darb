# Copy to .env and adjust. Used by VS Code launch (envFile) and optionally by docker compose.

# App
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8089
# Backend port default. If 8089 is taken, startup fails loudly (no silent port fallback).
# SERVER_PORT=8089

# Frontend (Vite — copy to frontend/.env.local or set in shell)
VITE_API_URL=http://localhost:8089

# Backend CORS — must include the Vite dev origin (3001 is Vite's fallback when 3000 is taken)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (host `localhost` when DB runs via Docker Compose port mapping)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=darb
DB_USER=darb
DB_PASSWORD=darb

# Generate: openssl rand -base64 32
JWT_SECRET=
