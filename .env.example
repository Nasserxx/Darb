# Copy to .env and adjust. Used by VS Code launch (envFile) and optionally by docker compose.

# App
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

# Frontend (Vite — copy to frontend/.env.local or set in shell)
VITE_API_URL=http://localhost:8080

# Backend CORS — must include the Vite dev origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (host `localhost` when DB runs via Docker Compose port mapping)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=darb
DB_USER=darb
DB_PASSWORD=darb
